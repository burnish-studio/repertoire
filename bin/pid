#!/usr/bin/env bash
# pid — pi adapter for the ~/.agent/ convention.
# Sources agent-core.sh for all harness-agnostic logic.
# Pi-specific: reads model from ~/.pi/settings.json; translates to pi flags.
set -euo pipefail

# ── source core ───────────────────────────────────────────────────────────────
CORE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/agent-core.sh"
# shellcheck source=agent-core.sh
source "$CORE"

# ── parse and handle ──────────────────────────────────────────────────────────
agent_parse_args "$@"

if [[ "$UPDATE" -eq 1 ]]; then
  agent_update
  exit 0
fi

agent_collect

# ── model (pi-specific: ~/.pi/settings.json) ──────────────────────────────────
_SETTINGS="$HOME/.pi/settings.json"
if [[ -f "$_SETTINGS" ]]; then
  _RAW=$(python3 -c "
import json
try:    print(json.load(open('$_SETTINGS')).get('defaultModel', ''))
except Exception:
    print('')
" 2>/dev/null || echo "")
  if [[ -n "$_RAW" ]]; then
    _SHORT=$(echo "$_RAW" | sed 's/^claude-//; s/\./-/g')
    trap 'rm -f "${AGENT_MODEL_TMPFILE:-}"' EXIT
    agent_inject_model "$_RAW" "$_SHORT"
  fi
fi

# ── manifest, doctor, verify ──────────────────────────────────────────────────
agent_print_manifest "pid"
[[ "$DOCTOR" -eq 1 ]] && agent_doctor && exit 0
[[ "$VERIFY" -eq 1 ]] && agent_verify && exit 0

# ── build pi flags and launch ─────────────────────────────────────────────────
PI_ARGS=(--no-context-files)

for f in "${APPENDS[@]}"; do
  PI_ARGS+=(--append-system-prompt "$f")
done

for s in "${SKILL_PATHS[@]}"; do
  PI_ARGS+=(--skill "$s")
done

exec pi "${PI_ARGS[@]}" "${USER_ARGS[@]}"
